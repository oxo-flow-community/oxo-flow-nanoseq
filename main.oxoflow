# oxo-flow port of nf-core/nanoseq 3.1.0 (default-parameters main path).
#
# Upstream: https://github.com/nf-core/nanoseq @ 3.1.0
#   (sha 6e563e54362cddb8e48d15c156251708c22d0e8d)
# Default path (protocol=DNA, demultiplexing ON, minimap2 aligner):
#   samplesheet check -> qcat demultiplex -> NanoPlot + FastQC ->
#   genome prep (samtools faidx x2 + chrom sizes) -> minimap2 index/align ->
#   samtools view/sort/index -> samtools stats/flagstat/idxstats ->
#   bedtools genomecov -> bedGraphToBigWig -> MultiQC (+ software versions).
#
# Fidelity notes:
# - Commands mirror the upstream modules byte-for-byte under default params;
#   upstream Groovy conditionals on params.* are reproduced as bash
#   conditionals over the same [config] keys.
# - Upstream process labels (cpus/memory from conf/base.config) are baked
#   into [rules.resources]. Upstream per-label time caps (4h/8h/16h) are not
#   ported (scheduler guards only).
# - The port keys per-sample rules by the *demultiplexed barcode* name
#   (barcode01, barcode02, ...). Upstream demultiplexes the raw fastq with
#   qcat into barcode-named files and then joins them onto samplesheet rows
#   by barcode; oxo-flow has no channel join, so the port's sample identity
#   IS the barcode. Outputs are named <barcode>.sam/.bam/.bigWig instead of
#   <group>_R<replicate>.* — see README fidelity table.
# - publishDir has no oxo-flow equivalent: outputs are written directly at
#   the published paths (results/qcat, results/nanoplot, results/fastqc,
#   results/minimap2, results/multiqc/minimap2, results/pipeline_info).
#   Steps upstream does NOT publish (genome prep, minimap2 index/sam/bam,
#   GTF2BED) are kept as internal intermediates under the same out_dir.
# - get_chrom_sizes + samtools_faidx both run `samtools faidx` on the
#   reference, exactly like upstream (two separate processes).
# - The upstream NanoPlot process publishes all samples' fixed-named
#   outputs (NanoPlot-report.html) into one dir, silently clobbering;
#   the port isolates each sample in nanoplot/<barcode>/.
# - GTF2BED only runs when the samplesheet/gtf config is set (default path
#   has no gtf, exactly like upstream where the channel is empty).
# - Upstream CUSTOM_DUMPSOFTWAREVERSIONS merges per-process versions.yml
#   collected at run time; the port pins the same versions statically
#   (assets/versions.yml, tool versions = container tags) and runs the
#   upstream merge script verbatim (materialized placeholders).

[workflow]
name = "oxo-flow-nanoseq"
version = "1.0.0"
description = "Nanopore demultiplexing (qcat), QC (NanoPlot + FastQC), minimap2 alignment and MultiQC — oxo-flow port of nf-core/nanoseq"
author = "oxo-flow-community"

[config]
# -- Samplesheet and demultiplexing input (upstream: --input / --input_path)
input = "test/fixtures/samplesheet.csv"
input_path = "test/fixtures/raw/sample.fastq.gz"
# -- Protocol (upstream: --protocol; mandatory upstream, one of DNA/cDNA/directRNA)
protocol = "DNA"
# -- Demultiplexing (upstream defaults)
# RBK001 matches the shipped barcoded fixture (qcat Auto-detection needs
# at least two distinct barcodes to guess the kit; the explicit kit makes
# the test path deterministic).
barcode_kit = "RBK001"
qcat_min_score = 60
qcat_detect_middle = false
skip_demultiplexing = false
# -- Raw read cleaning (upstream default: off). Upstream downloads the
#    lambda genome when --nanolyse_fasta is unset (GET_NANOLYSE_FASTA,
#    test-profile only); the port ships it as a checked-in fixture.
run_nanolyse = false
nanolyse_fasta = "test/fixtures/refs/lambda.fasta.gz"
# -- Alignment
aligner = "minimap2"
stranded = false
skip_alignment = false
# -- Pre-aligned BAM input (upstream: the samplesheet input_file column
#    carrying .bam files, used only when --skip_alignment; the port takes a
#    comma-separated list of bam paths, one per barcode in samples_list
#    order, linked by the bam_rename rule)
sample_bams = ""
# -- Suffix appended to per-sample bam names wherever rules consume reads:
#    ".sorted.bam" (alignment branch) or ".bam" (skip_alignment branch,
#    user bams linked by bam_rename). Mirrors the upstream channel swap
#    between BAM_SORT_INDEX_SAMTOOLS.out.sortbam and BAM_RENAME.out.bam.
bam_suffix = ".sorted.bam"
# -- Reference genome (collapses the samplesheet fasta column; the default
#    path uses a single reference for all samples, as in the upstream test data)
reference = "test/fixtures/refs/genome.fa"
# Basename of the reference; mirrors the upstream staged-file name so that
# indexes keep the upstream naming (genome.fa.mmi / genome.fa.sizes / genome.fa.fai)
reference_name = "genome.fa"
# -- GTF annotation (upstream samplesheet gtf column; empty on the default path)
gtf = ""
gtf_base = ""
# -- QC (upstream defaults: all QC on)
skip_qc = false
skip_nanoplot = false
skip_fastqc = false
skip_multiqc = false
# -- Visualisation (upstream defaults: bigwig/bigbed ON; bigbed is
#    protocol-gated upstream to cDNA/directRNA and so never runs on the
#    default DNA path)
skip_bigwig = false
skip_bigbed = false
# -- Variant calling (upstream default: off; also gated upstream on
#    protocol == DNA). The three short-variant callers are mutually
#    exclusive on variant_caller; structural callers on
#    structural_variant_caller (upstream defaults: medaka / sniffles).
call_variants = false
variant_caller = "medaka"
structural_variant_caller = "sniffles"
split_mnps = false
phase_vcf = false
skip_vc = false
skip_sv = false
deepvariant_gpu = false
# -- Quantification and differential analysis (upstream defaults: on, but
#    gated upstream to protocol cDNA/directRNA — never on the DNA path)
quantification_method = "bambu"
skip_quantification = false
skip_differential_analysis = false
# -- RNA modification analysis (upstream default: on, gated to protocol
#    directRNA; the fast5 dir comes from the upstream samplesheet
#    nanopolish_fast5 column — the port takes one dir for all samples)
skip_modification_analysis = false
skip_xpore = false
skip_m6anet = false
nanopolish_fast5 = ""
# -- MultiQC options
multiqc_title = ""
multiqc_config = ""
# -- Output directory (upstream: --outdir, default ./results)
out_dir = "results"

# One sample source per port (playbook §2.4): the demultiplexed barcodes.
# qcat names its outputs fastq/barcode01.fastq.gz, fastq/barcode02.fastq.gz, ...
# — these ARE the port's per-sample files (see fidelity notes above).
[[sample_groups]]
name = "cohort"
samples = ["barcode01", "barcode02"]

# ---------------------------------------------------------------------------
# 1. Samplesheet check (upstream: SAMPLESHEET_CHECK, label process_single)
# ---------------------------------------------------------------------------
[[rules]]
name = "samplesheet_check"
input = ["{config.input}"]
output = ["{config.out_dir}/pipeline_info/samplesheet.valid.csv"]
description = "Validate the input samplesheet with check_samplesheet.py"
shell = """
python3 scripts/check_samplesheet.py \\
    {config.input} \\
    not_changed \\
    {config.out_dir}/pipeline_info/samplesheet.valid.csv
"""

[rules.resources]
threads = 1
memory = "6G"

[rules.environment]
docker = "quay.io/biocontainers/python:3.8.3"

# ---------------------------------------------------------------------------
# 2. Demultiplex (upstream: QCAT, label process_medium)
#    Runs once on the raw fastq; qcat writes one fastq per detected barcode.
#    The declared outputs are the barcode set of the ported default path
#    (upstream emits fastq/*.fastq.gz dynamically for whatever barcodes the
#    kit/data contain).
# ---------------------------------------------------------------------------
[[rules]]
name = "qcat"
input = ["{config.input_path}"]
output = [
    "{config.out_dir}/qcat/fastq/barcode01.fastq.gz",
    "{config.out_dir}/qcat/fastq/barcode02.fastq.gz",
]
description = "Demultiplex the raw nanopore fastq with qcat"
when = "!config.skip_demultiplexing"
shell = """
## Unzip fastq file (qcat does not support zipped files)
FILE={config.input_path}
case "$FILE" in
  *.gz)
zcat {config.input_path} > unzipped.fastq
FILE=unzipped.fastq
    ;;
esac
## --detect-middle only when requested (upstream: params.qcat_detect_middle)
DETECT_MIDDLE=""
[ "{config.qcat_detect_middle}" = "true" ] && DETECT_MIDDLE="--detect-middle true"
mkdir -p {config.out_dir}/qcat/fastq
qcat \\
    -f $FILE \\
    -b {config.out_dir}/qcat/fastq \\
    --kit {config.barcode_kit} \\
    --min-score {config.qcat_min_score} \\
    $DETECT_MIDDLE

## Zip fastq files (gzip, as upstream) — qcat 1.1.0 writes .fastq.gz
## itself, so only still-uncompressed outputs are gzipped (idempotent).
for f in {config.out_dir}/qcat/fastq/*.fastq; do
  [ -e "$f" ] && gzip "$f"
done
true
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "quay.io/biocontainers/qcat:1.1.0--py_0"

# ---------------------------------------------------------------------------
# 3. NanoPlot QC (upstream: NANOPLOT, label process_low)
# ---------------------------------------------------------------------------
[[rules]]
name = "nanoplot"
input = ["{config.out_dir}/qcat/fastq/{sample}.fastq.gz"]
output = [
    "{config.out_dir}/nanoplot/{sample}/NanoPlot-report.html",
    "{config.out_dir}/nanoplot/{sample}/NanoPlot.log",
]
description = "FastQ QC with NanoPlot"
when = "!config.skip_qc && !config.skip_nanoplot"
shell = """
mkdir -p {config.out_dir}/nanoplot/{sample}
NanoPlot \\
    -t {threads} \\
    --fastq {input[0]} \\
    -o {config.out_dir}/nanoplot/{sample}

## upstream publishes *.html/*.txt/*.log per sample into results/nanoplot/
## (fixed output names); the port isolates each sample in its own subdir.
## The -o outdir is required: parallel rule instances share the workdir
## CWD and NanoPlot's fixed file names would race each other there
## (live evidence: mv 'No such file' as the sibling instance's mv moved
## the shared files first).
mv {config.out_dir}/nanoplot/{sample}/NanoPlot-report.html {output[0]}
# NanoPlot 1.41 writes a dated log (NanoPlot_<ts>.log), not NanoPlot.log,
# and no NanoPlot-data.tsv.gz for small inputs (verified in the pinned
# container) — the data tsv is not a declared output.
mv {config.out_dir}/nanoplot/{sample}/NanoPlot_*.log {output[1]}
"""

[rules.resources]
threads = 2
memory = "12G"

[rules.environment]
docker = "quay.io/biocontainers/nanoplot:1.41.0--pyhdfd78af_0"

# ---------------------------------------------------------------------------
# 4. FastQC (upstream: FASTQC, label process_medium)
# ---------------------------------------------------------------------------
[[rules]]
name = "fastqc"
input = ["{config.out_dir}/qcat/fastq/{sample}.fastq.gz"]
output = [
    "{config.out_dir}/fastqc/{sample}_fastqc.html",
    "{config.out_dir}/fastqc/{sample}_fastqc.zip",
]
description = "FastQ QC with FastQC"
when = "!config.skip_qc && !config.skip_fastqc"
shell = """
## Upstream renames the read to <prefix>.fastq.gz before QC so MultiQC
## sees per-sample names
printf "%s %s\\n" {input[0]} {sample}.fastq.gz | while read old_name new_name; do
    [ -f "${new_name}" ] || ln -s $old_name $new_name
done
fastqc --threads {threads} {sample}.fastq.gz

mv {sample}_fastqc.html {output[0]}
mv {sample}_fastqc.zip {output[1]}
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "quay.io/biocontainers/fastqc:0.11.9--0"

# ---------------------------------------------------------------------------
# 5. Chromosome sizes (upstream: GET_CHROM_SIZES, label process_medium)
#    Runs `samtools faidx` + `cut` on a local copy of the reference, exactly
#    like the upstream workdir-staged fasta.
# ---------------------------------------------------------------------------
[[rules]]
name = "get_chrom_sizes"
input = [
    "{config.reference}",
    # samtools_faidx output — declared so the DAG orders this rule after
    # indexing; the shell previously re-ran faidx inline, leaving the
    # faidx rule disconnected in the workflow graph.
    "{config.out_dir}/genome/{config.reference_name}.fai",
]
output = ["{config.out_dir}/genome/{config.reference_name}.sizes"]
description = "Make a chromosome sizes file from the reference fasta"
when = "!config.skip_alignment"
shell = """
cut -f 1,2 {config.out_dir}/genome/{config.reference_name}.fai > {config.out_dir}/genome/{config.reference_name}.sizes
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "quay.io/biocontainers/samtools:1.13--h8c37831_0"

# ---------------------------------------------------------------------------
# 6. Reference faidx (upstream: SAMTOOLS_FAIDX, label process_single)
#    A separate samtools faidx run, exactly like upstream (PREPARE_GENOME
#    runs GET_CHROM_SIZES AND SAMTOOLS_FAIDX).
# ---------------------------------------------------------------------------
[[rules]]
name = "samtools_faidx"
input = ["{config.reference}"]
output = ["{config.out_dir}/genome/{config.reference_name}.fai"]
description = "Index the reference fasta with samtools faidx"
when = "!config.skip_alignment"
shell = """
ln -sf {config.reference} {config.reference_name}
samtools \\
    faidx \\
    {config.reference_name}
mv {config.reference_name}.fai {output[0]}
"""

[rules.resources]
threads = 1
memory = "6G"

[rules.environment]
docker = "quay.io/biocontainers/samtools:1.16.1--h6899075_1"

# ---------------------------------------------------------------------------
# 7. GTF -> BED12 (upstream: GTF2BED, label process_low)
#    Off on the default path: upstream only runs it when the samplesheet
#    carries a gtf column (set config.gtf + config.gtf_base to enable).
# ---------------------------------------------------------------------------
[[rules]]
name = "gtf2bed"
input = ["{config.gtf}"]
output = ["{config.out_dir}/genome/{config.gtf_base}.bed"]
description = "Convert GTF to BED12 with gtf2bed (perl script, as upstream)"
when = 'config.gtf != ""'
shell = """
perl scripts/gtf2bed {config.gtf} > {config.out_dir}/genome/{config.gtf_base}.bed
"""

[rules.resources]
threads = 2
memory = "12G"

[rules.environment]
docker = "quay.io/biocontainers/perl:5.26.2"

# ---------------------------------------------------------------------------
# 8. minimap2 index (upstream: MINIMAP2_INDEX, label process_high)
#    Default params (protocol=DNA): -ax map-ont, no -k14, no -uf,
#    no --junc-bed — the Groovy conditionals are reproduced verbatim.
# ---------------------------------------------------------------------------
[[rules]]
name = "minimap2_index"
input = [
    "{config.reference}",
    "{config.out_dir}/genome/{config.reference_name}.sizes",
]
output = ["{config.out_dir}/minimap2/{config.reference_name}.mmi"]
description = "Create a minimap2 index of the reference"
when = '!config.skip_alignment && config.aligner == "minimap2"'
shell = """
## Upstream: preset = (protocol == 'DNA' || is_transcripts) ? "-ax map-ont" : "-ax splice"
PRESET="-ax map-ont"
[ "{config.protocol}" != "DNA" ] && PRESET="-ax splice"
## kmer = (protocol == 'directRNA') ? "-k14" : ""
KMER=""
[ "{config.protocol}" = "directRNA" ] && KMER="-k14"
## stranded = (stranded || protocol == 'directRNA') ? "-uf" : ""
STRANDED=""
if [ "{config.stranded}" = "true" ] || [ "{config.protocol}" = "directRNA" ]; then STRANDED="-uf"; fi
## junctions = (protocol != 'DNA' && bed) ? "--junc-bed <bed>" : ""
JUNCTIONS=""
if [ "{config.protocol}" != "DNA" ] && [ -n "{config.gtf_base}" ]; then JUNCTIONS="--junc-bed {config.out_dir}/genome/{config.gtf_base}.bed"; fi

minimap2 \\
    $PRESET \\
    $KMER \\
    $STRANDED \\
    $JUNCTIONS \\
    -t {threads} \\
    -d {config.out_dir}/minimap2/{config.reference_name}.mmi \\
    {config.reference}
"""

[rules.resources]
threads = 12
memory = "84G"

[rules.environment]
docker = "quay.io/biocontainers/minimap2:2.17--hed695b0_3"

# ---------------------------------------------------------------------------
# 9. minimap2 align (upstream: MINIMAP2_ALIGN, label process_medium)
# ---------------------------------------------------------------------------
[[rules]]
name = "minimap2_align"
input = [
    "{config.out_dir}/qcat/fastq/{sample}.fastq.gz",
    "{config.out_dir}/minimap2/{config.reference_name}.mmi",
    # gtf2bed output, referenced by the shell's --junc-bed flag — declared
    # so the DAG orders alignment after the BED conversion.
    "{config.out_dir}/genome/{config.gtf_base}.bed",
]
output = ["{config.out_dir}/minimap2/{sample}.sam"]
description = "Map reads with minimap2"
when = '!config.skip_alignment && config.aligner == "minimap2"'
shell = """
## Same preset/kmer/stranded/junctions logic as MINIMAP2_INDEX
PRESET="-ax map-ont"
[ "{config.protocol}" != "DNA" ] && PRESET="-ax splice"
KMER=""
[ "{config.protocol}" = "directRNA" ] && KMER="-k14"
STRANDED=""
if [ "{config.stranded}" = "true" ] || [ "{config.protocol}" = "directRNA" ]; then STRANDED="-uf"; fi
JUNCTIONS=""
if [ "{config.protocol}" != "DNA" ] && [ -n "{config.gtf_base}" ]; then JUNCTIONS="--junc-bed {config.out_dir}/genome/{config.gtf_base}.bed"; fi
## md = (call_variants && protocol == 'DNA') ? "--MD" : ""
MD=""
if [ "{config.call_variants}" = "true" ] && [ "{config.protocol}" = "DNA" ]; then MD="--MD"; fi

minimap2 \\
    $PRESET \\
    $KMER \\
    $STRANDED \\
    $JUNCTIONS \\
    $MD \\
    -t {threads} \\
    {config.out_dir}/minimap2/{config.reference_name}.mmi \\
    {input[0]} > {config.out_dir}/minimap2/{sample}.sam
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "quay.io/biocontainers/minimap2:2.17--hed695b0_3"

# ---------------------------------------------------------------------------
# 10. Sam -> Bam (upstream: SAMTOOLS_VIEW_BAM, label process_medium)
# ---------------------------------------------------------------------------
[[rules]]
name = "samtools_view"
input = ["{config.out_dir}/minimap2/{sample}.sam"]
output = ["{config.out_dir}/minimap2/{sample}.bam"]
description = "Convert SAM to BAM with samtools view"
when = "!config.skip_alignment"
shell = """
samtools view -b -h -O BAM -@ {threads} -o {config.out_dir}/minimap2/{sample}.bam {input[0]}
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "quay.io/biocontainers/samtools:1.15.1--h1170115_0"

# ---------------------------------------------------------------------------
# 11. Sort BAM (upstream: SAMTOOLS_SORT, label process_medium,
#     ext.prefix = "<sample>.sorted")
# ---------------------------------------------------------------------------
[[rules]]
name = "samtools_sort"
input = ["{config.out_dir}/minimap2/{sample}.bam"]
output = ["{config.out_dir}/minimap2/{sample}.sorted.bam"]
description = "Sort BAM with samtools sort"
when = "!config.skip_alignment && !config.call_variants"
shell = """
# capped per-thread buffer + effective threads: sort's default 768MB
# per thread over-allocates small machines (live: bam_mem allocation
# failure in the same class as tcasia's)
samtools sort -@ {effective_threads} -m 512M -o {config.out_dir}/minimap2/{sample}.sorted.bam -T {sample}.sorted {input[0]}
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "quay.io/biocontainers/samtools:1.16.1--h6899075_1"

# ---------------------------------------------------------------------------
# 12. Index BAM (upstream: SAMTOOLS_INDEX, label process_low,
#     -@ <cpus-1>)
# ---------------------------------------------------------------------------
[[rules]]
name = "samtools_index"
input = ["{config.out_dir}/minimap2/{sample}.sorted.bam"]
output = ["{config.out_dir}/minimap2/{sample}.sorted.bam.bai"]
description = "Index the sorted BAM with samtools index"
when = "!config.skip_alignment && !config.call_variants"
shell = """
samtools \\
    index \\
    -@ $(({threads} - 1)) \\
    {input[0]}
"""

[rules.resources]
threads = 2
memory = "12G"

[rules.environment]
docker = "quay.io/biocontainers/samtools:1.16.1--h6899075_1"

# ---------------------------------------------------------------------------
# 13. samtools stats (upstream: SAMTOOLS_STATS, label process_single)
# ---------------------------------------------------------------------------
[[rules]]
name = "samtools_stats"
input = [
    "{config.out_dir}/minimap2/{sample}.sorted.bam",
    "{config.out_dir}/minimap2/{sample}.sorted.bam.bai",
    "{config.reference}",
]
output = ["{config.out_dir}/minimap2/samtools_stats/{sample}.stats"]
description = "Run samtools stats on the sorted BAM"
when = "!config.skip_alignment"
shell = """
samtools \\
    stats \\
    --threads {threads} \\
    --reference {config.reference} \\
    {input[0]} \\
    > {config.out_dir}/minimap2/samtools_stats/{sample}.stats
"""

[rules.resources]
threads = 1
memory = "6G"

[rules.environment]
docker = "quay.io/biocontainers/samtools:1.16.1--h6899075_1"

# ---------------------------------------------------------------------------
# 14. samtools idxstats (upstream: SAMTOOLS_IDXSTATS, label process_single,
#     --threads <cpus-1>)
# ---------------------------------------------------------------------------
[[rules]]
name = "samtools_idxstats"
input = [
    "{config.out_dir}/minimap2/{sample}.sorted.bam",
    "{config.out_dir}/minimap2/{sample}.sorted.bam.bai",
]
output = ["{config.out_dir}/minimap2/samtools_stats/{sample}.idxstats"]
description = "Run samtools idxstats on the sorted BAM"
when = "!config.skip_alignment"
shell = """
samtools \\
    idxstats \\
    --threads $(({threads} - 1)) \\
    {input[0]} \\
    > {config.out_dir}/minimap2/samtools_stats/{sample}.idxstats
"""

[rules.resources]
threads = 1
memory = "6G"

[rules.environment]
docker = "quay.io/biocontainers/samtools:1.16.1--h6899075_1"

# ---------------------------------------------------------------------------
# 15. samtools flagstat (upstream: SAMTOOLS_FLAGSTAT, label process_single)
# ---------------------------------------------------------------------------
[[rules]]
name = "samtools_flagstat"
input = [
    "{config.out_dir}/minimap2/{sample}.sorted.bam",
    "{config.out_dir}/minimap2/{sample}.sorted.bam.bai",
]
output = ["{config.out_dir}/minimap2/samtools_stats/{sample}.flagstat"]
description = "Run samtools flagstat on the sorted BAM"
when = "!config.skip_alignment"
shell = """
samtools \\
    flagstat \\
    --threads {threads} \\
    {input[0]} \\
    > {config.out_dir}/minimap2/samtools_stats/{sample}.flagstat
"""

[rules.resources]
threads = 1
memory = "6G"

[rules.environment]
docker = "quay.io/biocontainers/samtools:1.16.1--h6899075_1"

# ---------------------------------------------------------------------------
# 16. BAM -> BEDGraph (upstream: BEDTOOLS_GENOMECOV, label process_medium)
#     Upstream hardcodes -split in the command (the computed `split` var is
#     dead code upstream) — the port keeps -split exactly.
# ---------------------------------------------------------------------------
[[rules]]
name = "bedtools_genomecov"
input = [
    "{config.out_dir}/minimap2/{sample}.sorted.bam",
    "{config.out_dir}/minimap2/{sample}.sorted.bam.bai",
]
output = ["{config.out_dir}/minimap2/bigwig/{sample}.bedGraph"]
description = "Convert BAM to BEDGraph with bedtools genomecov"
when = "!config.skip_alignment && !config.skip_bigwig"
shell = """
bedtools \\
    genomecov \\
    -split \\
    -ibam {input[0]} \\
    -bg \\
    | bedtools sort > {config.out_dir}/minimap2/bigwig/{sample}.bedGraph
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "quay.io/biocontainers/bedtools:2.29.2--hc088bd4_0"

# ---------------------------------------------------------------------------
# 17. BEDGraph -> BigWig (upstream: UCSC_BEDGRAPHTOBIGWIG,
#     label process_medium)
# ---------------------------------------------------------------------------
[[rules]]
name = "ucsc_bedgraphtobigwig"
input = [
    "{config.out_dir}/minimap2/bigwig/{sample}.bedGraph",
    "{config.out_dir}/genome/{config.reference_name}.sizes",
]
output = ["{config.out_dir}/minimap2/bigwig/{sample}.bigWig"]
description = "Convert BEDGraph to BigWig with bedGraphToBigWig"
when = "!config.skip_alignment && !config.skip_bigwig"
shell = """
bedGraphToBigWig {input[0]} {input[1]} {config.out_dir}/minimap2/bigwig/{sample}.bigWig
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "quay.io/biocontainers/ucsc-bedgraphtobigwig:377--h446ed27_1"

# ---------------------------------------------------------------------------
# 18. Software versions (upstream: CUSTOM_DUMPSOFTWAREVERSIONS,
#     label process_single). Upstream merges per-process versions.yml files
#     collected at run time; the port merges the statically pinned
#     assets/versions.yml with the same upstream merge script.
# ---------------------------------------------------------------------------
[[rules]]
name = "dumpsoftwareversions"
input = ["assets/versions.yml"]
output = [
    "{config.out_dir}/pipeline_info/software_versions.yml",
    "{config.out_dir}/pipeline_info/software_versions_mqc.yml",
]
description = "Merge per-tool versions into MultiQC-ready yml files"
shell = """
python3 scripts/dumpsoftwareversions.py {input[0]} {config.out_dir}/pipeline_info
"""

[rules.resources]
threads = 1
memory = "6G"

[rules.environment]
docker = "quay.io/biocontainers/multiqc:1.13--pyhdfd78af_0"

# ---------------------------------------------------------------------------
# 19. MultiQC (upstream: MULTIQC, label process_medium)
#     Gather rule: collects FastQC + samtools stats outputs per sample plus
#     the software-versions and pipeline-summary ymls, then runs
#     `multiqc -f .` exactly like upstream.
# ---------------------------------------------------------------------------
[[rules]]
name = "multiqc"
input = [
    "assets/multiqc_config.yml",
    "assets/workflow_summary_mqc.yaml",
    "{config.out_dir}/pipeline_info/software_versions_mqc.yml",
]
expand_inputs = [
    { pattern = "{config.out_dir}/fastqc/{sample}_fastqc.zip",  variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/fastqc/{sample}_fastqc.html", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/minimap2/samtools_stats/{sample}.stats",     variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/minimap2/samtools_stats/{sample}.flagstat",  variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/minimap2/samtools_stats/{sample}.idxstats",  variables = { sample = "config.samples_list" } },
]
output = ["{config.out_dir}/multiqc/minimap2/multiqc_report.html"]
description = "Aggregate QC and alignment stats into a MultiQC report"
when = "!config.skip_multiqc"
shell = """
## Upstream stages all report inputs into one dir and runs `multiqc -f .`
OUT={config.out_dir}/multiqc/minimap2
mkdir -p "$OUT"
for f in {input}; do
    # absolute target: the link lives in $OUT, so a relative target
    # would resolve against $OUT and dangle (live: MultiQC found
    # nothing but broken links — 'No analysis results found')
    ln -sf "$PWD/$f" "$OUT/"
done
cd "$OUT"
ARGS=""
[ -n "{config.multiqc_title}" ] && ARGS="--title \\"{config.multiqc_title}\\""
CUSTOM_CONFIG=""
[ -n "{config.multiqc_config}" ] && CUSTOM_CONFIG="--config {config.multiqc_config}"
multiqc \\
    -f \\
    $ARGS \\
    $CUSTOM_CONFIG \\
    .
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "quay.io/biocontainers/multiqc:1.11--pyhdfd78af_0"

# ---------------------------------------------------------------------------
# 20. Raw read cleaning (upstream: NANOLYSE, label process_low)
#     Off by default (run_nanolyse = false). Upstream re-feeds the cleaned
#     reads into the QC/alignment channels; oxo-flow has no channel
#     reassignment, so the port writes the cleaned reads to results/nanolyse/
#     and the downstream chain keeps consuming the demultiplexed reads
#     (deviation, see README).
# ---------------------------------------------------------------------------
[[rules]]
name = "nanolyse"
input = [
    "{config.out_dir}/qcat/fastq/{sample}.fastq.gz",
    "{config.nanolyse_fasta}",
]
output = [
    "{config.out_dir}/nanolyse/{sample}.fastq.gz",
    "{config.out_dir}/nanolyse/{sample}.nanolyse.log",
]
description = "Remove contaminant DNA reads with NanoLyse"
when = "config.run_nanolyse"
shell = """
gunzip -c {input[0]} | NanoLyse -r {input[1]} | gzip > {config.out_dir}/nanolyse/{sample}.fastq.gz
mv NanoLyse.log {config.out_dir}/nanolyse/{sample}.nanolyse.log
"""

[rules.resources]
threads = 2
memory = "12G"

[rules.environment]
docker = "quay.io/biocontainers/nanolyse:1.2.0--py_0"

# ---------------------------------------------------------------------------
# 21-22. Graphmap2 aligner branch (upstream: GRAPHMAP2_INDEX/GRAPHMAP2_ALIGN,
#     label process_high) — active only when aligner = "graphmap2".
#     Deviation: the port keeps the shared results/minimap2/ namespace so the
#     downstream view/sort/index/stats/coverage chain needs no per-aligner
#     duplicates; upstream publishes the graphmap2 branch under
#     results/graphmap2/.
# ---------------------------------------------------------------------------
[[rules]]
name = "graphmap2_index"
input = [
    "{config.reference}",
    "{config.out_dir}/genome/{config.reference_name}.sizes",
]
output = ["{config.out_dir}/minimap2/{config.reference_name}.gmidx"]
description = "Create a graphmap2 index of the reference"
when = '!config.skip_alignment && config.aligner == "graphmap2"'
shell = """
## Stage the reference under its basename so the index keeps the upstream
## naming (<fasta>.gmidx); graphmap2 index mode = `align -I`
ln -sf {config.reference} {config.reference_name}
## preset = (protocol == 'DNA' || is_transcripts) ? "" : "-x rnaseq"
## (the port does not model the per-sample is_transcripts column — the
## non-DNA default, same convention as the minimap2 rules)
PRESET="-x rnaseq"
[ "{config.protocol}" = "DNA" ] && PRESET=""
## junctions = (protocol != 'DNA' && !is_transcripts && gtf) ? "--gtf <gtf>" : ""
JUNCTIONS=""
if [ "{config.protocol}" != "DNA" ] && [ -n "{config.gtf}" ]; then JUNCTIONS="--gtf {config.gtf}"; fi

graphmap2 \\
    align \\
    $PRESET \\
    $JUNCTIONS \\
    -t {threads} \\
    -I \\
    -r {config.reference_name}

mv {config.reference_name}.gmidx {config.out_dir}/minimap2/{config.reference_name}.gmidx
"""

[rules.resources]
threads = 12
memory = "84G"

[rules.environment]
docker = "quay.io/biocontainers/graphmap:0.6.3--he513fc3_0"

[[rules]]
name = "graphmap2_align"
input = [
    "{config.out_dir}/qcat/fastq/{sample}.fastq.gz",
    "{config.out_dir}/minimap2/{config.reference_name}.gmidx",
    "{config.reference}",
]
output = ["{config.out_dir}/minimap2/{sample}.sam"]
description = "Map reads with graphmap2"
when = '!config.skip_alignment && config.aligner == "graphmap2"'
shell = """
PRESET="-x rnaseq"
[ "{config.protocol}" = "DNA" ] && PRESET=""
JUNCTIONS=""
if [ "{config.protocol}" != "DNA" ] && [ -n "{config.gtf}" ]; then JUNCTIONS="--gtf {config.gtf}"; fi

graphmap2 \\
    align \\
    $PRESET \\
    $JUNCTIONS \\
    -t {threads} \\
    -r {config.reference} \\
    -i {config.out_dir}/minimap2/{config.reference_name}.gmidx \\
    -d {input[0]} \\
    -o {config.out_dir}/minimap2/{sample}.sam \\
    --extcigar
"""

[rules.resources]
threads = 12
memory = "84G"

[rules.environment]
docker = "quay.io/biocontainers/graphmap:0.6.3--he513fc3_0"

# ---------------------------------------------------------------------------
# 23. Combined sort + index (upstream: SAMTOOLS_SORT_INDEX, label
#     process_low) — active only in the variant-calling branch: upstream runs
#     the combined sort+index instead of the separate SAMTOOLS_SORT +
#     SAMTOOLS_INDEX when call_variants = true (those rules are then skipped).
#     Same capped-buffer sort deviation as samtools_sort (live evidence).
# ---------------------------------------------------------------------------
[[rules]]
name = "samtools_sort_index"
input = ["{config.out_dir}/minimap2/{sample}.bam"]
output = [
    "{config.out_dir}/minimap2/{sample}.sorted.bam",
    "{config.out_dir}/minimap2/{sample}.sorted.bam.bai",
]
description = "Sort and index BAM in one step (variant-calling branch)"
when = "!config.skip_alignment && config.call_variants"
shell = """
samtools sort -@ {effective_threads} -m 512M -o {config.out_dir}/minimap2/{sample}.sorted.bam -T {sample}.sorted {input[0]}
samtools index {config.out_dir}/minimap2/{sample}.sorted.bam
"""

[rules.resources]
threads = 2
memory = "12G"

[rules.environment]
docker = "quay.io/biocontainers/samtools:1.16.1--h6899075_1"

# ---------------------------------------------------------------------------
# 24. BAM rename (upstream: BAM_RENAME, label process_medium)
#     Runs only with skip_alignment = true and pre-aligned per-barcode bams
#     (upstream: the samplesheet input_file column carrying .bam files; the
#     port takes sample_bams, a comma-separated list in samples_list order).
#     Links each user bam under the port barcode name, exactly like the
#     upstream `[ ! -f ] && ln -s` preamble.
# ---------------------------------------------------------------------------
[[rules]]
name = "bam_rename"
# expand_inputs over the comma-separated config list splits it into one
# concrete path per bam (resolve_config_list semantics) and injects them
# into rule.input, so `{input}` is space-joined in samples_list order.
input = []
expand_inputs = [
    { pattern = "{bam}", variables = { bam = "config.sample_bams" } },
]
output = [
    "{config.out_dir}/minimap2/barcode01.bam",
    "{config.out_dir}/minimap2/barcode02.bam",
]
description = "Link user-provided BAMs under the port barcode names"
when = 'config.skip_alignment && config.sample_bams != ""'
shell = """
IFS=' ' read -ra BAMS <<< "{input}"
[ ! -f {config.out_dir}/minimap2/barcode01.bam ] && ln -s "${BAMS[0]}" {config.out_dir}/minimap2/barcode01.bam
[ ! -f {config.out_dir}/minimap2/barcode02.bam ] && ln -s "${BAMS[1]}" {config.out_dir}/minimap2/barcode02.bam
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "quay.io/biocontainers/sed:4.7.0"

# ---------------------------------------------------------------------------
# 25-26. BigBed tracks (upstream: BEDTOOLS_BAMBED + UCSC_BED12TOBIGBED, label
#     process_medium). The upstream module `when` gates both to protocol
#     directRNA/cDNA — off on the default DNA path, exactly like the port's
#     bigwig twin rules.
# ---------------------------------------------------------------------------
[[rules]]
name = "bedtools_bamtobed"
input = [
    "{config.out_dir}/minimap2/{sample}.sorted.bam",
    "{config.out_dir}/minimap2/{sample}.sorted.bam.bai",
]
output = ["{config.out_dir}/minimap2/bigbed/{sample}.bed12"]
description = "Convert BAM to BED12 with bedtools bamtobed"
when = '!config.skip_alignment && !config.skip_bigbed && (config.protocol == "directRNA" || config.protocol == "cDNA")'
shell = """
bedtools \\
    bamtobed \\
    -bed12 \\
    -cigar \\
    -i {input[0]} \\
    | bedtools sort > {config.out_dir}/minimap2/bigbed/{sample}.bed12
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "quay.io/biocontainers/bedtools:2.29.2--hc088bd4_0"

[[rules]]
name = "ucsc_bed12tobigbed"
input = [
    "{config.out_dir}/minimap2/bigbed/{sample}.bed12",
    "{config.out_dir}/genome/{config.reference_name}.sizes",
]
output = ["{config.out_dir}/minimap2/bigbed/{sample}.bigBed"]
description = "Convert BED12 to BigBED with bedToBigBed"
when = '!config.skip_alignment && !config.skip_bigbed && (config.protocol == "directRNA" || config.protocol == "cDNA")'
shell = """
bedToBigBed {input[0]} {input[1]} {config.out_dir}/minimap2/bigbed/{sample}.bigBed
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "quay.io/biocontainers/ucsc-bedtobigbed:377--h446ed27_1"

# ---------------------------------------------------------------------------
# 27-33. Short variant calling (upstream: SHORT_VARIANT_CALLING, gated on
#     call_variants && protocol == 'DNA'). The three callers are mutually
#     exclusive on config.variant_caller (upstream default medaka); outputs
#     are bgzip'd/tabix'd like upstream and published under
#     results/variant_calling/<caller>/.
# ---------------------------------------------------------------------------
[[rules]]
name = "medaka_variant"
input = [
    "{config.out_dir}/minimap2/{sample}.sorted.bam",
    "{config.out_dir}/minimap2/{sample}.sorted.bam.bai",
    "{config.reference}",
]
output = ["{config.out_dir}/variant_calling/medaka_variant/{sample}/round_1.vcf"]
description = "Call short variants with medaka"
when = 'config.call_variants && config.protocol == "DNA" && !config.skip_vc && config.variant_caller == "medaka"'
shell = """
## split_mnps = params.split_mnps ? "-l" : "" (upstream)
SPLIT_MNPS=""
[ "{config.split_mnps}" = "true" ] && SPLIT_MNPS="-l"
## phase_vcf = params.phase_vcf ? "-p" : "" (upstream)
PHASE_VCF=""
[ "{config.phase_vcf}" = "true" ] && PHASE_VCF="-p"

medaka_variant \\
    -d \\
    -f {config.reference} \\
    -i {input[0]} \\
    -o {config.out_dir}/variant_calling/medaka_variant/{sample} \\
    -t {threads} \\
    $SPLIT_MNPS \\
    $PHASE_VCF

## medaka 1.4.4 writes round_0_hap_mixed_unphased.vcf (+ .hdf); the
## declared output keeps the upstream round_1.vcf contract.
mv {config.out_dir}/variant_calling/medaka_variant/{sample}/round_0_hap_mixed_unphased.vcf \\
   {config.out_dir}/variant_calling/medaka_variant/{sample}/round_1.vcf
"""

[rules.resources]
threads = 12
memory = "84G"

[rules.environment]
docker = "quay.io/biocontainers/medaka:1.4.4--py38h130def0_0"

[[rules]]
name = "medaka_bgzip_vcf"
input = ["{config.out_dir}/variant_calling/medaka_variant/{sample}/round_1.vcf"]
output = ["{config.out_dir}/variant_calling/medaka_variant/{sample}.vcf.gz"]
description = "Bgzip the medaka VCF (upstream: TABIX_BGZIP as MEDAKA_BGZIP_VCF)"
when = 'config.call_variants && config.protocol == "DNA" && !config.skip_vc && config.variant_caller == "medaka"'
shell = """
bgzip -c -@ {threads} {input[0]} > {config.out_dir}/variant_calling/medaka_variant/{sample}.vcf.gz
"""

[rules.resources]
threads = 1
memory = "6G"

[rules.environment]
docker = "quay.io/biocontainers/tabix:1.11--hdfd78af_0"

[[rules]]
name = "medaka_tabix_vcf"
input = ["{config.out_dir}/variant_calling/medaka_variant/{sample}.vcf.gz"]
output = ["{config.out_dir}/variant_calling/medaka_variant/{sample}.vcf.gz.tbi"]
description = "Tabix-index the medaka VCF (upstream: TABIX_TABIX as MEDAKA_TABIX_VCF)"
when = 'config.call_variants && config.protocol == "DNA" && !config.skip_vc && config.variant_caller == "medaka"'
shell = """
tabix {input[0]}
"""

[rules.resources]
threads = 1
memory = "6G"

[rules.environment]
docker = "quay.io/biocontainers/tabix:1.11--hdfd78af_0"

[[rules]]
name = "deepvariant"
input = [
    "{config.out_dir}/minimap2/{sample}.sorted.bam",
    "{config.out_dir}/minimap2/{sample}.sorted.bam.bai",
    "{config.reference}",
    "{config.out_dir}/genome/{config.reference_name}.fai",
]
output = [
    "{config.out_dir}/variant_calling/deepvariant/{sample}.vcf.gz",
    "{config.out_dir}/variant_calling/deepvariant/{sample}.g.vcf.gz",
]
description = "Call short variants with DeepVariant (docker-only upstream)"
when = 'config.call_variants && config.protocol == "DNA" && !config.skip_vc && config.variant_caller == "deepvariant"'
shell = """
## ext.args = "--model_type WGS" (upstream modules.config)
/opt/deepvariant/bin/run_deepvariant \\
    --ref={config.reference} \\
    --reads={input[0]} \\
    --output_vcf={config.out_dir}/variant_calling/deepvariant/{sample}.vcf.gz \\
    --output_gvcf={config.out_dir}/variant_calling/deepvariant/{sample}.g.vcf.gz \\
    --model_type WGS \\
    --num_shards={threads}
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "google/deepvariant:1.4.0"

[[rules]]
name = "deepvariant_tabix_vcf"
input = ["{config.out_dir}/variant_calling/deepvariant/{sample}.vcf.gz"]
output = ["{config.out_dir}/variant_calling/deepvariant/{sample}.vcf.gz.tbi"]
description = "Tabix-index the DeepVariant VCF (upstream: DEEPVARIANT_TABIX_VCF)"
when = 'config.call_variants && config.protocol == "DNA" && !config.skip_vc && config.variant_caller == "deepvariant"'
shell = """
tabix {input[0]}
"""

[rules.resources]
threads = 1
memory = "6G"

[rules.environment]
docker = "quay.io/biocontainers/tabix:1.11--hdfd78af_0"

[[rules]]
name = "deepvariant_tabix_gvcf"
input = ["{config.out_dir}/variant_calling/deepvariant/{sample}.g.vcf.gz"]
output = ["{config.out_dir}/variant_calling/deepvariant/{sample}.g.vcf.gz.tbi"]
description = "Tabix-index the DeepVariant gVCF (upstream: DEEPVARIANT_TABIX_GVCF)"
when = 'config.call_variants && config.protocol == "DNA" && !config.skip_vc && config.variant_caller == "deepvariant"'
shell = """
tabix {input[0]}
"""

[rules.resources]
threads = 1
memory = "6G"

[rules.environment]
docker = "quay.io/biocontainers/tabix:1.11--hdfd78af_0"

[[rules]]
name = "pepper_margin_deepvariant"
input = [
    "{config.out_dir}/minimap2/{sample}.sorted.bam",
    "{config.out_dir}/minimap2/{sample}.sorted.bam.bai",
    "{config.reference}",
    "{config.out_dir}/genome/{config.reference_name}.fai",
]
output = [
    "{config.out_dir}/variant_calling/margin_pepper_deepvariant/{sample}.vcf.gz",
    "{config.out_dir}/variant_calling/margin_pepper_deepvariant/{sample}.vcf.gz.tbi",
]
description = "Call short variants with PEPPER-Margin-DeepVariant"
when = 'config.call_variants && config.protocol == "DNA" && !config.skip_vc && config.variant_caller == "pepper_margin_deepvariant"'
shell = """
## gpu = params.deepvariant_gpu ? "-g" : "" (upstream); the CPU container is
## pinned here — set deepvariant_gpu = true only after swapping the image to
## docker.io/kishwars/pepper_deepvariant:r0.8-gpu
GPU=""
[ "{config.deepvariant_gpu}" = "true" ] && GPU="-g"
## ext.args = "--ont_r9_guppy5_sup" (upstream modules.config)
run_pepper_margin_deepvariant call_variant \\
    -b "{input[0]}" \\
    -f "{config.reference}" \\
    -o "{config.out_dir}/variant_calling/margin_pepper_deepvariant" \\
    -p "{sample}" \\
    -t {threads} \\
    $GPU \\
    --ont_r9_guppy5_sup
"""

[rules.resources]
threads = 12
memory = "84G"

[rules.environment]
docker = "docker.io/kishwars/pepper_deepvariant:r0.8"

# ---------------------------------------------------------------------------
# 34-39. Structural variant calling (upstream: STRUCTURAL_VARIANT_CALLING,
#     gated on call_variants && protocol == 'DNA', mutually exclusive on
#     config.structural_variant_caller: sniffles (default) / cutesv). The raw
#     caller VCFs are sorted with bcftools sort (bgzipped output) and
#     tabix-indexed, published under results/variant_calling/<caller>/.
# ---------------------------------------------------------------------------
[[rules]]
name = "sniffles"
input = [
    "{config.out_dir}/minimap2/{sample}.sorted.bam",
    "{config.out_dir}/minimap2/{sample}.sorted.bam.bai",
]
output = ["{config.out_dir}/variant_calling/sniffles/{sample}_sniffles.vcf"]
description = "Call structural variants with Sniffles"
when = 'config.call_variants && config.protocol == "DNA" && !config.skip_sv && config.structural_variant_caller == "sniffles"'
shell = """
sniffles \\
    -m {input[0]} \\
    -v {config.out_dir}/variant_calling/sniffles/{sample}_sniffles.vcf \\
    -t {threads}
"""

[rules.resources]
threads = 12
memory = "84G"

[rules.environment]
docker = "quay.io/biocontainers/sniffles:1.0.12--h8b12597_1"

[[rules]]
name = "sniffles_sort_vcf"
input = ["{config.out_dir}/variant_calling/sniffles/{sample}_sniffles.vcf"]
output = ["{config.out_dir}/variant_calling/sniffles/{sample}.vcf.gz"]
description = "Sort the Sniffles VCF with bcftools sort (upstream: BCFTOOLS_SORT as SNIFFLES_SORT_VCF)"
when = 'config.call_variants && config.protocol == "DNA" && !config.skip_sv && config.structural_variant_caller == "sniffles"'
shell = """
bcftools \\
    sort \\
    --output {config.out_dir}/variant_calling/sniffles/{sample}.vcf.gz \\
    {input[0]}
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "quay.io/biocontainers/bcftools:1.16--hfe4b78e_1"

[[rules]]
name = "sniffles_tabix_vcf"
input = ["{config.out_dir}/variant_calling/sniffles/{sample}.vcf.gz"]
output = ["{config.out_dir}/variant_calling/sniffles/{sample}.vcf.gz.tbi"]
description = "Tabix-index the Sniffles VCF (upstream: SNIFFLES_TABIX_VCF)"
when = 'config.call_variants && config.protocol == "DNA" && !config.skip_sv && config.structural_variant_caller == "sniffles"'
shell = """
tabix {input[0]}
"""

[rules.resources]
threads = 1
memory = "6G"

[rules.environment]
docker = "quay.io/biocontainers/tabix:1.11--hdfd78af_0"

[[rules]]
name = "cutesv"
input = [
    "{config.out_dir}/minimap2/{sample}.sorted.bam",
    "{config.out_dir}/minimap2/{sample}.sorted.bam.bai",
    "{config.reference}",
]
output = ["{config.out_dir}/variant_calling/cutesv/{sample}_cuteSV.vcf"]
description = "Call structural variants with cuteSV"
when = 'config.call_variants && config.protocol == "DNA" && !config.skip_sv && config.structural_variant_caller == "cutesv"'
shell = """
cuteSV \\
    {input[0]} \\
    {config.reference} \\
    {config.out_dir}/variant_calling/cutesv/{sample}_cuteSV.vcf \\
    . \\
    --threads {threads} \\
    --sample {sample} \\
    --genotype
"""

[rules.resources]
threads = 12
memory = "84G"

[rules.environment]
docker = "quay.io/biocontainers/cutesv:1.0.12--pyhdfd78af_0"

[[rules]]
name = "cutesv_sort_vcf"
input = ["{config.out_dir}/variant_calling/cutesv/{sample}_cuteSV.vcf"]
output = ["{config.out_dir}/variant_calling/cutesv/{sample}.vcf.gz"]
description = "Sort the cuteSV VCF with bcftools sort (upstream: BCFTOOLS_SORT as CUTESV_SORT_VCF)"
when = 'config.call_variants && config.protocol == "DNA" && !config.skip_sv && config.structural_variant_caller == "cutesv"'
shell = """
bcftools \\
    sort \\
    --output {config.out_dir}/variant_calling/cutesv/{sample}.vcf.gz \\
    {input[0]}
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "quay.io/biocontainers/bcftools:1.16--hfe4b78e_1"

[[rules]]
name = "cutesv_tabix_vcf"
input = ["{config.out_dir}/variant_calling/cutesv/{sample}.vcf.gz"]
output = ["{config.out_dir}/variant_calling/cutesv/{sample}.vcf.gz.tbi"]
description = "Tabix-index the cuteSV VCF (upstream: CUTESV_TABIX_VCF)"
when = 'config.call_variants && config.protocol == "DNA" && !config.skip_sv && config.structural_variant_caller == "cutesv"'
shell = """
tabix {input[0]}
"""

[rules.resources]
threads = 1
memory = "6G"

[rules.environment]
docker = "quay.io/biocontainers/tabix:1.11--hdfd78af_0"

# ---------------------------------------------------------------------------
# 40-47. Quantification and differential analysis (upstream: gated on
#     protocol cDNA/directRNA — off on the default DNA path). Two mutually
#     exclusive methods on config.quantification_method: bambu (default,
#     single gather rule) or stringtie2 (per-sample stringtie2 + merge +
#     featureCounts). Both methods write counts_gene.txt/counts_transcript.
#     txt; DESEQ2/DEXSEQ consume whichever method produced them and publish
#     under results/bambu/deseq2|dexseq exactly like upstream (even for the
#     stringtie2 method — an upstream publishDir quirk kept verbatim; the
#     two same-output rule pairs are mutually exclusive via the
#     quantification_method gate).
# ---------------------------------------------------------------------------
[[rules]]
name = "bambu"
input = [
    "{config.reference}",
    "{config.gtf}",
]
expand_inputs = [
    { pattern = "{config.out_dir}/minimap2/{sample}{config.bam_suffix}", variables = { sample = "config.samples_list" } },
]
output = [
    "{config.out_dir}/bambu/counts_gene.txt",
    "{config.out_dir}/bambu/counts_transcript.txt",
    "{config.out_dir}/bambu/extended_annotations.gtf",
]
description = "Quantify transcripts with bambu"
when = 'config.protocol != "DNA" && !config.skip_quantification && config.quantification_method == "bambu"'
shell = """
IFS=' ' read -ra IN <<< "{input}"
Rscript scripts/run_bambu.r \\
    --tag=. \\
    --ncore={threads} \\
    --annotation={input[1]} \\
    --fasta={input[0]} \\
    "${IN[@]:2}"
mv counts_gene.txt counts_transcript.txt extended_annotations.gtf {config.out_dir}/bambu/
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "quay.io/biocontainers/bioconductor-bambu:3.0.8--r42hc247a5b_0"

[[rules]]
name = "stringtie2"
input = [
    "{config.out_dir}/minimap2/{sample}{config.bam_suffix}",
    "{config.reference}",
    "{config.gtf}",
]
output = ["{config.out_dir}/stringtie2/{sample}.stringtie.gtf"]
description = "Assemble transcripts with StringTie2"
when = 'config.protocol != "DNA" && !config.skip_quantification && config.quantification_method == "stringtie2"'
shell = """
stringtie \\
    -L \\
    -G {config.gtf} \\
    -o {config.out_dir}/stringtie2/{sample}.stringtie.gtf \\
    {input[0]}
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "quay.io/biocontainers/stringtie:2.1.4--h7e0af3c_0"

[[rules]]
name = "stringtie_merge"
input = []
expand_inputs = [
    { pattern = "{config.out_dir}/stringtie2/{sample}.stringtie.gtf", variables = { sample = "config.samples_list" } },
]
output = ["{config.out_dir}/stringtie2/stringtie.merged.gtf"]
description = "Merge StringTie2 assemblies (upstream: STRINGTIE_MERGE)"
when = 'config.protocol != "DNA" && !config.skip_quantification && config.quantification_method == "stringtie2"'
shell = """
IFS=' ' read -ra IN <<< "{input}"
## reference = annotation_gtf ? "-G <gtf>" : "" (upstream)
REFERENCE=""
[ -n "{config.gtf}" ] && REFERENCE="-G {config.gtf}"
stringtie \\
    --merge "${IN[@]}" \\
    $REFERENCE \\
    -o {config.out_dir}/stringtie2/stringtie.merged.gtf
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "quay.io/biocontainers/stringtie:2.2.1--hecb563c_2"

[[rules]]
name = "subread_featurecounts"
input = ["{config.out_dir}/stringtie2/stringtie.merged.gtf"]
expand_inputs = [
    { pattern = "{config.out_dir}/minimap2/{sample}{config.bam_suffix}", variables = { sample = "config.samples_list" } },
]
output = [
    "{config.out_dir}/stringtie2/featureCounts/counts_gene.txt",
    "{config.out_dir}/stringtie2/featureCounts/counts_transcript.txt",
    "{config.out_dir}/stringtie2/featureCounts/counts_gene.txt.summary",
    "{config.out_dir}/stringtie2/featureCounts/counts_transcript.txt.summary",
]
description = "Quantify genes and transcripts with featureCounts"
when = 'config.protocol != "DNA" && !config.skip_quantification && config.quantification_method == "stringtie2"'
shell = """
IFS=' ' read -ra IN <<< "{input}"
featureCounts \\
    -L \\
    -O \\
    -f \\
    -g gene_id \\
    -t exon \\
    -T {threads} \\
    -a ${IN[0]} \\
    -o {config.out_dir}/stringtie2/featureCounts/counts_gene.txt \\
    "${IN[@]:1}"

featureCounts \\
    -L \\
    -O \\
    -f \\
    --primary \\
    --fraction \\
    -F GTF \\
    -g transcript_id \\
    -t transcript \\
    --extraAttributes gene_id \\
    -T {threads} \\
    -a ${IN[0]} \\
    -o {config.out_dir}/stringtie2/featureCounts/counts_transcript.txt \\
    "${IN[@]:1}"
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "quay.io/biocontainers/subread:2.0.1--hed695b0_0"

[[rules]]
name = "deseq2"
input = ["{config.out_dir}/bambu/counts_gene.txt"]
output = ["{config.out_dir}/bambu/deseq2/deseq2.results.txt"]
description = "Differential gene expression with DESeq2 (bambu counts)"
when = 'config.protocol != "DNA" && !config.skip_quantification && !config.skip_differential_analysis && config.quantification_method == "bambu"'
shell = """
Rscript scripts/run_deseq2.r bambu {input[0]}
mv deseq2.results.txt {config.out_dir}/bambu/deseq2/deseq2.results.txt
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "quay.io/biocontainers/mulled-v2-8849acf39a43cdd6c839a369a74c0adc823e2f91:ab110436faf952a33575c64dd74615a84011450b-0"

[[rules]]
name = "deseq2_featurecounts"
input = ["{config.out_dir}/stringtie2/featureCounts/counts_gene.txt"]
output = ["{config.out_dir}/bambu/deseq2/deseq2.results.txt"]
description = "Differential gene expression with DESeq2 (featureCounts counts)"
when = 'config.protocol != "DNA" && !config.skip_quantification && !config.skip_differential_analysis && config.quantification_method == "stringtie2"'
shell = """
Rscript scripts/run_deseq2.r stringtie2 {input[0]}
mv deseq2.results.txt {config.out_dir}/bambu/deseq2/deseq2.results.txt
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "quay.io/biocontainers/mulled-v2-8849acf39a43cdd6c839a369a74c0adc823e2f91:ab110436faf952a33575c64dd74615a84011450b-0"

[[rules]]
name = "dexseq"
input = ["{config.out_dir}/bambu/counts_transcript.txt"]
output = ["{config.out_dir}/bambu/dexseq/dexseq.results.txt"]
description = "Differential transcript usage with DEXSeq (bambu counts)"
when = 'config.protocol != "DNA" && !config.skip_quantification && !config.skip_differential_analysis && config.quantification_method == "bambu"'
shell = """
Rscript scripts/run_dexseq.r bambu {input[0]}
mv dexseq.results.txt {config.out_dir}/bambu/dexseq/dexseq.results.txt
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "docker.io/yuukiiwa/nanoseq:dexseq"

[[rules]]
name = "dexseq_featurecounts"
input = ["{config.out_dir}/stringtie2/featureCounts/counts_transcript.txt"]
output = ["{config.out_dir}/bambu/dexseq/dexseq.results.txt"]
description = "Differential transcript usage with DEXSeq (featureCounts counts)"
when = 'config.protocol != "DNA" && !config.skip_quantification && !config.skip_differential_analysis && config.quantification_method == "stringtie2"'
shell = """
Rscript scripts/run_dexseq.r stringtie2 {input[0]}
mv dexseq.results.txt {config.out_dir}/bambu/dexseq/dexseq.results.txt
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "docker.io/yuukiiwa/nanoseq:dexseq"

# ---------------------------------------------------------------------------
# 48-52. RNA modification analysis (upstream: RNA_MODIFICATION_XPORE_M6ANET,
#     gated on protocol directRNA — off on the default DNA path). Nanopolish
#     event-aligns the raw signal against the reference; xPore (skip_xpore)
#     and m6anet (skip_m6anet) each run dataprep + analysis on the
#     eventalign output. Upstream takes per-sample fast5 dirs from the
#     samplesheet nanopolish_fast5 column; the port takes one dir for all
#     samples (config.nanopolish_fast5) and gates the branch off when unset.
# ---------------------------------------------------------------------------
[[rules]]
name = "nanopolish_index_eventalign"
input = [
    "{config.out_dir}/qcat/fastq/{sample}.fastq.gz",
    "{config.out_dir}/minimap2/{sample}{config.bam_suffix}",
    "{config.out_dir}/minimap2/{sample}{config.bam_suffix}.bai",
    "{config.reference}",
]
output = [
    "{config.out_dir}/rna_modifications/nanopolish/{sample}_summary.txt",
    "{config.out_dir}/rna_modifications/nanopolish/{sample}_eventalign.txt",
]
description = "Event-align nanopore reads to the reference with Nanopolish"
when = 'config.protocol == "directRNA" && !config.skip_modification_analysis && config.nanopolish_fast5 != ""'
shell = """
nanopolish index -d {config.nanopolish_fast5} {input[0]}
nanopolish eventalign \\
    --reads {input[0]} \\
    --bam {input[1]} \\
    --genome {config.reference} \\
    --scale-events \\
    --signal-index \\
    --summary {config.out_dir}/rna_modifications/nanopolish/{sample}_summary.txt \\
    --threads {threads} \\
    > {config.out_dir}/rna_modifications/nanopolish/{sample}_eventalign.txt
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "quay.io/biocontainers/nanopolish:0.13.2--he3b7ca5_2"

[[rules]]
name = "xpore_dataprep"
input = [
    "{config.out_dir}/rna_modifications/nanopolish/{sample}_eventalign.txt",
    "{config.reference}",
    "{config.gtf}",
]
output = ["{config.out_dir}/rna_modifications/xpore/dataprep/{sample}"]
description = "Prepare eventalign data for xPore"
when = 'config.protocol == "directRNA" && !config.skip_modification_analysis && !config.skip_xpore && config.nanopolish_fast5 != ""'
shell = """
xpore dataprep \\
    --eventalign {input[0]} \\
    --out_dir {config.out_dir}/rna_modifications/xpore/dataprep/{sample} \\
    --n_processes {threads} \\
    --genome --gtf_or_gff {input[2]} --transcript_fasta {input[1]}
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "quay.io/biocontainers/xpore:2.1--pyh5e36f6f_0"

[[rules]]
name = "xpore_diffmod"
input = []
expand_inputs = [
    { pattern = "{config.out_dir}/rna_modifications/xpore/dataprep/{sample}", variables = { sample = "config.samples_list" } },
]
output = ["{config.out_dir}/rna_modifications/xpore/diffmod/diffmod_outputs"]
description = "Differential modification analysis with xPore"
when = 'config.protocol == "directRNA" && !config.skip_modification_analysis && !config.skip_xpore && config.nanopolish_fast5 != ""'
depends_on = ["xpore_dataprep"]
shell = """
IFS=' ' read -ra DIRS <<< "{input}"
ARGS=""
for d in "${DIRS[@]}"; do
    ARGS="$ARGS $d,$(basename "$d")"
done
## upstream: `xpore diffmod --config $workflow.workDir/*/*/diffmod_config.yml`;
## the port runs create_yml.py and xpore diffmod in the same workdir, so the
## config path is the local file (the upstream glob is a workdir workaround)
python3 scripts/create_yml.py diffmod_config.yml $ARGS
xpore diffmod --config diffmod_config.yml --n_processes {threads}
mv diffmod_outputs {config.out_dir}/rna_modifications/xpore/diffmod/
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "quay.io/biocontainers/xpore:2.1--pyh5e36f6f_0"

[[rules]]
name = "m6anet_dataprep"
input = ["{config.out_dir}/rna_modifications/nanopolish/{sample}_eventalign.txt"]
output = ["{config.out_dir}/rna_modifications/m6anet/dataprep/{sample}"]
description = "Prepare eventalign data for m6anet"
when = 'config.protocol == "directRNA" && !config.skip_modification_analysis && !config.skip_m6anet && config.nanopolish_fast5 != ""'
shell = """
m6anet-dataprep \\
    --eventalign {input[0]} \\
    --out_dir {config.out_dir}/rna_modifications/m6anet/dataprep/{sample} \\
    --n_processes {threads}
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "docker.io/yuukiiwa/m6anet:1.0"

[[rules]]
name = "m6anet_inference"
input = ["{config.out_dir}/rna_modifications/m6anet/dataprep/{sample}"]
output = ["{config.out_dir}/rna_modifications/m6anet/inference/{sample}_results"]
description = "Detect m6A sites with m6anet"
when = 'config.protocol == "directRNA" && !config.skip_modification_analysis && !config.skip_m6anet && config.nanopolish_fast5 != ""'
depends_on = ["m6anet_dataprep"]
shell = """
m6anet-run_inference \\
    --input_dir {input[0]} \\
    --out_dir {config.out_dir}/rna_modifications/m6anet/inference/{sample}_results \\
    --batch_size 512 \\
    --n_processes {threads} \\
    --num_iterations 5 \\
    --device cpu
"""

[rules.resources]
threads = 6
memory = "42G"

[rules.environment]
docker = "docker.io/yuukiiwa/m6anet:1.0"

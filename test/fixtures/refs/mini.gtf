# Mini annotation fixture for the cDNA/directRNA quantification branches.
# Two synthetic transcripts over the fixture reference (chr1); generated to
# exercise bambu/stringtie2/deseq2/dexseq without external downloads
# (snakemake/nextflow-style minimal test annotation).
chr1	mini	source	1	1	.	+	.	transcript_id "mini_tx1";
chr1	mini	transcript	100	600	.	+	.	gene_id "mini_gene1"; transcript_id "mini_tx1";
chr1	mini	exon	100	300	.	+	.	gene_id "mini_gene1"; transcript_id "mini_tx1";
chr1	mini	exon	450	600	.	+	.	gene_id "mini_gene1"; transcript_id "mini_tx1";
chr1	mini	transcript	700	1200	.	-	.	gene_id "mini_gene2"; transcript_id "mini_tx2";
chr1	mini	exon	700	900	.	-	.	gene_id "mini_gene2"; transcript_id "mini_tx2";
chr1	mini	exon	1000	1200	.	-	.	gene_id "mini_gene2"; transcript_id "mini_tx2";
